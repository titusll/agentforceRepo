<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
        <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
    </targets>
     <targetConfigs>
        <targetConfig targets="lightning__FlowScreen, lightning__HomePage, lightning__AppPage">
            <property name="alertTitle" label="Alert Title" type="String"/>
            <property name="alertMessage" label="Alert Message" type="String"/>
            <property name="alertType" label="Alert Type" type="String" 
                      datasource="info,quotation_marks,success,warning,error" 
                      default="info" 
                      description="Controls styling for the alert (info/success/warning/error)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>